# Upstream Gloo credentials. Use ONE of:
#   1. A Gloo API key (recommended by Gloo)
GLOO_API_KEY=
#   2. Deprecated OAuth2 client credentials (GLOO_AI_CLIENT_ID / GLOO_AI_CLIENT_SECRET also work)
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
# If neither is set, the bearer token / x-api-key sent by the client is forwarded to Gloo as-is.

# Local listener
PORT=9797
HOST=127.0.0.1

# Optional: require clients to send this token (as ANTHROPIC_AUTH_TOKEN / x-api-key / Bearer).
PROXY_AUTH_TOKEN=

# Optional model routing.
# JSON object of exact-id overrides, applied before the automatic claude-* -> gloo-anthropic-* mapping.
GLOO_MODEL_MAP={}
# Used when a requested id cannot be mapped to a model in Gloo's catalog.
GLOO_DEFAULT_MODEL=gloo-anthropic-claude-sonnet-4.6

# Model godex uses when -m is not given.
GODEX_MODEL=gloo-anthropic-claude-sonnet-4.6

# Anthropic prompt caching on Gloo is enabled via the X-Cache-TTL header.
# "auto" sends it whenever the request carries cache_control breakpoints; "5m"/"1h" force it; "off" disables.
GLOO_CACHE_TTL=auto

# Forward Anthropic `thinking` as Responses `reasoning` (true/false).
GLOO_FORWARD_REASONING=true

# Tool schema shape sent to Gloo: "nested" ({type,function:{...}}, per Gloo docs) or "flat".
GLOO_TOOL_SCHEMA=nested

# Log translated requests and raw upstream events to stderr.
GLOO_PROXY_DEBUG=false
